# ==========================================
# StudyMate Backend Environment Variables
# Copy these to your Render Web Service Environment settings
# ==========================================

# Database Configuration (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-db-password>
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Groq AI API Key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# CORS Allowed Origins (Comma-separated)
# Automatically supports localhost and *.vercel.app by default
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app
